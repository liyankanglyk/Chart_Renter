# Add directories or file patterns to ignore during indexing (e.g. foo/ or *.csv)
# 忽略目录
docs/
data/


# 忽略git文件
.gitignore
.git


# 忽略爬虫生成的原始数据文件
*.csv
*.json
*.xlsx
*.xls


# 忽略缓存和临时文件
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# 忽略环境文件
venv/
env/
.env
.venv
.python-version

# 忽略日志文件
logs/
*.log

# 忽略前端构建文件
frontend/node_modules/
frontend/dist/
frontend/.DS_Store
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# 忽略Scrapy生成的文件
.scrapy/

# 忽略大型数据集和模型文件
data/raw/
models/trained/
*.pkl

# 忽略IDE配置文件
.idea/
.vscode/
*.swp
*.swo

